# Supabase project settings (Project Settings -> API).
# The service role key is only read on the server (app/api/waitlist/route.ts).
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for share links and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nowline.org
